GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Conversation router profile (app/config/llm.py). gemini_default uses
# GEMINI_MODEL. groq_gpt_oss_20b is available, but Groq's on-demand tier
# allows 8K tokens/minute - about two routed messages a minute with the
# router prompt - which failed the 2026-10-15 e2e baseline (429s).
ROUTER_LLM_PROFILE=gemini_default

# Dedicated model for the semantic evidence verifier
# (app.logic.semantic_evidence_verification). Independent of GEMINI_MODEL
# above - must stay the exact model family validated in
# evaluation/experiments/verifier_comparison unless re-benchmarked.
SEMANTIC_VERIFIER_MODEL="gemini-2.5-flash"

# Only for scripts/benchmarks and source="apify" experiments. The public
# API always searches the bundled sample listings and never calls Apify.
# The retriever reads APIFY_BOOKING_ACTOR (default voyager~booking-scraper).
APIFY_TOKEN=""
APIFY_BOOKING_ACTOR_ID="voyager/booking-scraper"


FX_API_URL=https://api.frankfurter.dev/v2/rates?base=USD
FX_CACHE_PATH=data/fx_rates_usd.json
FX_CACHE_TTL_DAYS=10

# Optional fixed "today" (YYYY-MM-DD) for date interpretation. Leave unset
# to use the real date. Tests and evaluation runners pin their own date.
# APP_REFERENCE_DATE=2026-10-15

# --- Public chat API usage limits (app/api/usage_limits.py) ---------------
# Checked on the server before any LLM call; a rejected request gets 429 and
# changes nothing. They count chat turns, not money - keep a provider-side
# spend cap as well.
# BOOKING_API_VISITOR_TURNS=8           # per visitor (client IP)...
# BOOKING_API_VISITOR_WINDOW_HOURS=24   # ...in a rolling window
# BOOKING_API_GLOBAL_TURNS_PER_DAY=30   # all visitors, per UTC day
# BOOKING_API_MAX_CONCURRENT_TURNS=2    # turns in flight at once
# BOOKING_API_USAGE_DB=var/usage.sqlite3  # must be on persistent storage in production
# Only behind a proxy that sets it, e.g. Fly-Client-IP or CF-Connecting-IP:
# BOOKING_API_CLIENT_IP_HEADER=
# 1 = also write per-turn telemetry files (they include the message text):
# BOOKING_API_PERSIST_TELEMETRY=
