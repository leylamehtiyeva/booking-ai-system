GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Conversation router profile (app/config/llm.py). gemini_default uses
# GEMINI_MODEL. groq_gpt_oss_20b is available, but Groq's on-demand tier
# allows 8K tokens/minute - about two routed messages a minute with the
# router prompt - which failed the 2026-10-15 e2e baseline (429s).
ROUTER_LLM_PROFILE=gemini_default

# Dedicated model for the semantic evidence verifier
# (app.logic.semantic_evidence_verification). Independent of GEMINI_MODEL
# above - must stay the exact model family validated in
# evaluation/experiments/verifier_comparison unless re-benchmarked.
SEMANTIC_VERIFIER_MODEL="gemini-2.5-flash"

APIFY_TOKEN=""
APIFY_BOOKING_ACTOR_ID="voyager/booking-scraper"


FX_API_URL=https://api.frankfurter.dev/v2/rates?base=USD
FX_CACHE_PATH=data/fx_rates_usd.json
FX_CACHE_TTL_DAYS=10

# Optional fixed "today" (YYYY-MM-DD) for date interpretation. Leave unset
# to use the real date. Tests and evaluation runners pin their own date.
# APP_REFERENCE_DATE=2026-10-15
