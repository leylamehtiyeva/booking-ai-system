---
import { ArrowRight, MessageSquareText } from "lucide-react";
import { STARTER_PROMPTS, FOLLOW_UP_PROMPTS } from "../demo/prompts";
import { LIVE_DEMO, REPO_URL } from "../../lib/site";

const demoLink = (prompt: string) => `/demo?q=${encodeURIComponent(prompt)}`;
const statuses = [
  { label: "Confirmed", className: "bg-ok-soft text-ok" },
  { label: "Not confirmed", className: "bg-warn-soft text-warn" },
  { label: "Not satisfied", className: "bg-bad-soft text-bad" },
];

// Live: try the demo online. Static portfolio: the same three steps, but
// nothing promises an online demo that is not running.
const step1 = LIVE_DEMO
  ? {
      title: "Open the live demo",
      body: "The demo talks to the real backend. It searches a bundled sample dataset, so listings, prices and links are illustrative.",
      href: "/demo",
      cta: "Open the live demo",
    }
  : {
      title: "See it in action",
      body: "The walkthrough shows the demo replaying responses the real backend produced on a bundled sample dataset. It is recorded, not a live session.",
      href: "#walkthrough",
      cta: "See the walkthrough",
    };
const step2 = LIVE_DEMO
  ? { title: "Describe your ideal stay", body: "City, dates, budget and what matters to you. Or open the demo with one of these prompts:", label: "Example prompts for the sample dataset" }
  : {
      title: "Follow a request through the system",
      body: "These are the prompts behind the recorded examples. How it works traces the first one through all seven stages.",
      label: "Prompts used in the recorded examples",
    };
---

<section id="getting-started" class="section">
  <div class="mx-auto max-w-4xl px-6">
    <div class="mb-14 text-center">
      <h2 class="text-[1.75rem] font-bold tracking-tight text-ink md:text-3xl">How to get started</h2>
      <p class="mt-3 text-muted">{LIVE_DEMO ? "Three steps, all in the browser. Nothing to install." : "Three steps to see what Booking AI does and how it is built."}</p>
    </div>

    <ol class="space-y-10">
      <li class="flex gap-5">
        <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-full bg-ink text-sm font-bold text-white">1</span>
        <div class="min-w-0 flex-1">
          <h3 class="text-base font-semibold text-ink">{step1.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted">{step1.body}</p>
          <a href={step1.href} class="btn btn-ghost mt-4">
            {step1.cta}
            <ArrowRight size={14} strokeWidth={1.75} aria-hidden="true" />
          </a>
        </div>
      </li>

      <li class="flex gap-5">
        <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-full bg-ink text-sm font-bold text-white">2</span>
        <div class="min-w-0 flex-1">
          <h3 class="text-base font-semibold text-ink">{step2.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted">{step2.body}</p>
          <div class="mt-4 overflow-hidden rounded-xl border border-line">
            <div class="flex items-center gap-2 border-b border-line bg-gray-100 px-4 py-2.5 text-xs text-subtle">
              <MessageSquareText size={13} strokeWidth={1.5} aria-hidden="true" />
              {step2.label}
            </div>
            <div class="space-y-2 bg-paper-sunk p-3">
              {STARTER_PROMPTS.slice(0, LIVE_DEMO ? undefined : 2).map((prompt, index) =>
                LIVE_DEMO ? (
                  <a href={demoLink(prompt)} class="group flex items-start gap-2.5 rounded-lg border border-gray-100 bg-white p-3 transition-colors hover:border-line-strong">
                    <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-gray-200 text-xs font-medium text-muted">{index + 1}</span>
                    <span class="text-sm leading-snug text-ink-soft group-hover:text-ink">{prompt}</span>
                  </a>
                ) : (
                  <div class="flex items-start gap-2.5 rounded-lg border border-gray-100 bg-white p-3">
                    <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-gray-200 text-xs font-medium text-muted">{index + 1}</span>
                    <span class="text-sm leading-snug text-ink-soft">{prompt}</span>
                  </div>
                ),
              )}
            </div>
          </div>
          {!LIVE_DEMO && (
            <a href="#how-it-works" class="btn btn-ghost mt-4">
              Explore how it works
              <ArrowRight size={14} strokeWidth={1.75} aria-hidden="true" />
            </a>
          )}
        </div>
      </li>

      <li class="flex gap-5">
        <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-full bg-ink text-sm font-bold text-white">3</span>
        <div class="min-w-0 flex-1">
          <h3 class="text-base font-semibold text-ink">{LIVE_DEMO ? "Explore and refine recommendations" : "Explore the source code"}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted">
            {
              LIVE_DEMO
                ? "Every listing card sorts your requirements into three groups. Open the Decision Inspector to see why, then refine in your own words."
                : "Every listing card sorts requirements into three groups, and the Decision Inspector shows why. The code behind each verdict is on GitHub."
            }
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            {statuses.map((s) => <span class:list={["rounded-md px-2.5 py-1 text-xs font-medium", s.className]}>{s.label}</span>)}
          </div>
          {
            LIVE_DEMO ? (
              <>
                <p class="mt-4 text-xs font-medium text-muted">Try as a follow-up:</p>
                <div class="mt-2 flex flex-wrap gap-2">
                  {FOLLOW_UP_PROMPTS.map((prompt) => (
                    <span class="rounded-lg border border-line bg-paper-sunk px-3 py-1.5 font-mono text-xs text-ink-soft">{prompt}</span>
                  ))}
                </div>
              </>
            ) : (
              <a href={REPO_URL} class="btn btn-ghost mt-4" rel="noopener">
                View source code
                <ArrowRight size={14} strokeWidth={1.75} aria-hidden="true" />
              </a>
            )
          }
        </div>
      </li>
    </ol>
  </div>
</section>
