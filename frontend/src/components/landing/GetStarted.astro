---
import { ArrowRight, MessageSquareText } from "lucide-react";
import { STARTER_PROMPTS, FOLLOW_UP_PROMPTS } from "../demo/prompts";

const demoLink = (prompt: string) => `/demo?q=${encodeURIComponent(prompt)}`;
const statuses = [
  { label: "Confirmed", className: "bg-ok-soft text-ok" },
  { label: "Not confirmed", className: "bg-warn-soft text-warn" },
  { label: "Not satisfied", className: "bg-bad-soft text-bad" },
];
---

<section id="getting-started" class="section">
  <div class="mx-auto max-w-4xl px-6">
    <div class="mb-14 text-center">
      <h2 class="text-[1.75rem] font-bold tracking-tight text-ink md:text-3xl">How to get started</h2>
      <p class="mt-3 text-muted">Three steps, all in the browser. Nothing to install.</p>
    </div>

    <ol class="space-y-10">
      <li class="flex gap-5">
        <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-full bg-ink text-sm font-bold text-white">1</span>
        <div class="min-w-0 flex-1">
          <h3 class="text-base font-semibold text-ink">Open the live demo</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted">
            The demo talks to the real backend. It searches a bundled sample dataset, so listings, prices and links are illustrative.
          </p>
          <a href="/demo" class="btn btn-ghost mt-4">
            Open the live demo
            <ArrowRight size={14} strokeWidth={1.75} aria-hidden="true" />
          </a>
        </div>
      </li>

      <li class="flex gap-5">
        <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-full bg-ink text-sm font-bold text-white">2</span>
        <div class="min-w-0 flex-1">
          <h3 class="text-base font-semibold text-ink">Describe your ideal stay</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted">City, dates, budget and what matters to you. Or open the demo with one of these prompts:</p>
          <div class="mt-4 overflow-hidden rounded-xl border border-line">
            <div class="flex items-center gap-2 border-b border-line bg-gray-100 px-4 py-2.5 text-xs text-subtle">
              <MessageSquareText size={13} strokeWidth={1.5} aria-hidden="true" />
              Example prompts for the sample dataset
            </div>
            <div class="space-y-2 bg-paper-sunk p-3">
              {STARTER_PROMPTS.map((prompt, index) => (
                <a href={demoLink(prompt)} class="group flex items-start gap-2.5 rounded-lg border border-gray-100 bg-white p-3 transition-colors hover:border-line-strong">
                  <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-gray-200 text-xs font-medium text-muted">{index + 1}</span>
                  <span class="text-sm leading-snug text-ink-soft group-hover:text-ink">{prompt}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </li>

      <li class="flex gap-5">
        <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-full bg-ink text-sm font-bold text-white">3</span>
        <div class="min-w-0 flex-1">
          <h3 class="text-base font-semibold text-ink">Explore and refine recommendations</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted">
            Every listing card sorts your requirements into three groups. Open the Decision Inspector to see why, then refine in your own words.
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            {statuses.map((s) => <span class:list={["rounded-md px-2.5 py-1 text-xs font-medium", s.className]}>{s.label}</span>)}
          </div>
          <p class="mt-4 text-xs font-medium text-muted">Try as a follow-up:</p>
          <div class="mt-2 flex flex-wrap gap-2">
            {FOLLOW_UP_PROMPTS.map((prompt) => (
              <span class="rounded-lg border border-line bg-paper-sunk px-3 py-1.5 font-mono text-xs text-ink-soft">{prompt}</span>
            ))}
          </div>
        </div>
      </li>
    </ol>
  </div>
</section>
