---
import recorded from "../../mocks/turns.json";
import type { TurnResult } from "../../lib/types";
import SectionHeader from "./SectionHeader.astro";
import UseCaseTabs, { type Scenario } from "./UseCaseTabs";

// Exchanges recorded from the real backend on the sample listings.
type Step = { request: string; response: TurnResult };
const all = recorded as unknown as Record<string, Step[]>;
const [search, refine, question] = all.search_refine_ask;
const [clarify] = all.budget_clarification;
const firstCard = search.response.listing_cards[0];
const refinedCard = refine.response.listing_cards[0];
const optional = firstCard.needs_confirmation[0];
const answer = question.response.inspector.listing_query[0];

const scenarios: Scenario[] = [
  {
    id: "search",
    label: "Search with multiple requirements",
    title: "One message, several requirements",
    summary: "Dates, budget, required amenities and an optional wish in a single request.",
    messages: [
      { role: "user", text: search.request },
      { role: "assistant", text: `${search.response.listing_cards.length} options in Baku for April 10–15. Here is the first one.` },
    ],
    card: firstCard,
    points: [
      "WiFi and kitchen are required; the quiet street is only nice to have.",
      "The budget is per night, so it is checked against the total for five nights.",
    ],
  },
  {
    id: "refine",
    label: "Refine a search",
    title: "Change one thing, keep the rest",
    summary: "Add or drop a requirement in your own words.",
    messages: [
      { role: "user", text: refine.request },
      { role: "assistant", text: `Updated: ${refine.response.listing_cards.map((c) => c.title).join(" and ")}.` },
    ],
    card: refinedCard,
    points: [
      "The balcony is added to the existing search as a small patch.",
      "City, dates, budget and the other requirements are kept as they were.",
    ],
  },
  {
    id: "question",
    label: "Ask about a listing",
    title: "Follow-up questions about a shown listing",
    summary: "“The first one” refers to the results you were actually shown.",
    messages: [
      { role: "user", text: question.request },
      { role: "assistant", text: question.response.assistant_message },
    ],
    points: [
      `The reference is checked against the shown results: #${answer.position}, ${answer.title}.`,
      `Verdict for “${answer.match.constraint_results[0].raw_text}”: ${answer.match.constraint_results[0].value}. Without evidence the answer is “couldn’t verify”, not “no”.`,
    ],
  },
  {
    id: "uncertain",
    label: "Understand unconfirmed details",
    title: "What is not confirmed, and what is unclear",
    summary: "Unconfirmed details are labelled; unclear requests get one short question.",
    messages: [
      { role: "user", text: clarify.request },
      { role: "assistant", text: clarify.response.assistant_message },
    ],
    points: [
      "A budget without “per night” or “for the stay” is asked about before any search runs.",
      `Optional wishes the data cannot confirm stay visible: “${optional.label}” — ${optional.reason}.`,
      "A required item that is not confirmed keeps a listing from being a strong match.",
    ],
  },
];
---

<section id="use-cases" class="section">
  <div class="container-page">
    <SectionHeader title="Use cases" subtitle="Real exchanges recorded from the backend on the demo’s sample dataset. Pick a scenario." />
    <UseCaseTabs client:visible scenarios={scenarios} />
  </div>
</section>
