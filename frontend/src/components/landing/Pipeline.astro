---
import recorded from "../../mocks/turns.json";
import type { TurnResult } from "../../lib/types";
import { budgetText, PRIORITY_TEXT, stayText } from "../../lib/present";
import SectionHeader from "./SectionHeader.astro";

// One recorded turn on the sample listings illustrates every step.
const flow = (recorded as unknown as Record<string, { request: string; response: TurnResult }[]>).search_refine_ask;
const step = flow[0];
const refine = flow[1];
const search = step.response.inspector.current_search!;
const results = step.response.inspector.results;
const card = step.response.listing_cards[0];

type Kind = "LLM" | "LLM + Deterministic" | "Deterministic";
const TAG: Record<Kind, string> = { LLM: "tag-llm", "LLM + Deterministic": "tag-llm", Deterministic: "tag-det" };

const steps: { title: string; kind: Kind; body: string }[] = [
  {
    title: "Conversation Router",
    kind: "LLM",
    body: "Decides what each message is: a new search, a change to the current one, a question about a shown listing, or general chat. An ambiguous turn gets a clarifying question, and a reference like “the first one” is checked against the results actually shown.",
  },
  {
    title: "Intent Extraction / State Update",
    kind: "LLM + Deterministic",
    body: "An LLM turns a new request into a typed search, or a follow-up into a small patch to it. Code validates dates, asks when a budget could be per night or for the stay, and applies the patch, so earlier requirements are kept.",
  },
  {
    title: "Retrieval",
    kind: "Deterministic",
    body: "Candidate listings for the city and dates come from the listing source: a bundled sample dataset in the demo, or an optional Apify-based retriever. Retrieval does not use embeddings.",
  },
  {
    title: "Structured and Numeric Matching",
    kind: "Deterministic",
    body: "Each requirement is checked against canonical listing fields such as amenities, policies and room facilities. Price, bedrooms, bathrooms and area are compared as numbers; an area must belong to the room or apartment being booked.",
  },
  {
    title: "Textual Evidence Resolution",
    kind: "LLM + Deterministic",
    body: "Requirements no field can answer are read from the listing text. The model must quote its evidence, each quote is verified against the listing, and code turns the signals into confirmed, not confirmed or not satisfied.",
  },
  {
    title: "Ranking & Selection",
    kind: "Deterministic",
    body: "Eligible listings are sorted into strong, partial and weak matches and the top ones are selected. A required item that is not confirmed never makes a strong match.",
  },
  {
    title: "Response generation",
    kind: "LLM",
    body: "An LLM words the already-decided outcome, with a deterministic fallback. Answers about listing facts are rendered directly from the verdict, so a decided fact is never reworded.",
  },
];

const requirements = search.constraints.map((c) => `${c.normalized_text} · ${PRIORITY_TEXT[c.priority] ?? c.priority}`);
const FLOW = ["Router", "Intent / state", "Retrieval", "Matching", "Evidence", "Ranking", "Response"];
---

<section id="how-it-works" class="section section-alt">
  <div class="mx-auto max-w-4xl px-6">
    <SectionHeader
      level="major"
      title="How it works"
      subtitle="Seven stages run on every search turn. Under each one, a real request recorded on the sample dataset shows what that stage produces."
    />

    <!-- How the stages connect. -->
    <div class="mb-12 rounded-xl border border-line bg-white p-5">
      <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-2 text-xs font-medium text-ink-soft" aria-label="Search turn">
        {FLOW.map((name, index) => (
          <li class="flex items-center gap-1.5">
            <span class="rounded-md border border-line bg-paper-sunk px-2 py-1">
              <span class="mr-1 text-subtle">{index + 1}</span>{name}
            </span>
            {index < FLOW.length - 1 && <span class="text-subtle" aria-hidden="true">→</span>}
          </li>
        ))}
      </ol>
      <p class="mt-3 text-xs leading-relaxed text-muted">
        A question about a shown listing takes a shorter path: Router → the shown listing it refers to → the question turned into requirements
        (LLM) → matching and evidence for that listing → a verdict rendered directly, without the response LLM. A clarifying question can end
        any turn before retrieval.
      </p>
      <p class="mt-3 flex flex-wrap gap-3 text-xs text-muted">
        <span class="inline-flex items-center gap-1.5"><span class="tag tag-llm">LLM</span> interprets language and evidence</span>
        <span class="inline-flex items-center gap-1.5"><span class="tag tag-det">Deterministic</span> decides state changes and verdicts</span>
      </p>
    </div>

    <ol class="relative space-y-8 before:absolute before:bottom-4 before:left-[1.125rem] before:top-4 before:w-px before:bg-line">
      {steps.map((item, index) => (
        <li class="relative flex gap-5">
          <span class="relative z-10 mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-full bg-ink text-sm font-bold text-white">{index + 1}</span>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="text-base font-semibold text-ink">{item.title}</h3>
              <span class:list={["tag", TAG[item.kind]]}>{item.kind}</span>
            </div>
            <p class="mt-1.5 text-sm leading-relaxed text-muted">{item.body}</p>

            <div class="mt-3 rounded-lg border border-line bg-white px-4 py-3 text-[0.82rem] leading-relaxed text-ink-soft">
              {index === 0 && (
                <div class="space-y-1.5">
                  <p class="font-mono text-xs">“{step.request}”</p>
                  <p class="font-mono text-xs text-muted">→ new search · later “{refine.request}” → change to the current search</p>
                </div>
              )}
              {index === 1 && (
                <div class="space-y-2">
                  <p class="font-mono text-xs text-muted">
                    city: {search.city} · stay: {stayText(search)} · budget: {budgetText(search)}
                  </p>
                  <ul class="flex flex-wrap gap-1.5">
                    {requirements.map((r) => <li class="rounded-md border border-line bg-paper-sunk px-2 py-0.5 text-xs">{r}</li>)}
                  </ul>
                </div>
              )}
              {index === 2 && <p>Apartments in {search.city} available {stayText(search)} from the sample dataset, priced for the requested nights.</p>}
              {index === 3 && (
                <ul class="grid gap-1 sm:grid-cols-2">
                  {card.confirmed.map((p) => (
                    <li class="flex gap-2"><span class="text-ok">✓</span><span><span class="font-medium text-ink">{p.label}</span> <span class="text-muted">· {p.reason}</span></span></li>
                  ))}
                  {card.needs_confirmation.map((p) => (
                    <li class="flex gap-2"><span class="text-warn">?</span><span><span class="font-medium text-ink">{p.label}</span> <span class="text-muted">· no structured field</span></span></li>
                  ))}
                </ul>
              )}
              {index === 4 && (
                <div class="space-y-1.5">
                  <p class="text-muted">Another sample listing, Sunny Central Apartment, asked about a “quiet location”:</p>
                  <p class="border-l-2 border-line-strong pl-3 italic text-ink">“Quiet street but still central.”</p>
                  <p class="font-mono text-xs text-muted">quote found in listing text → confirmed</p>
                </div>
              )}
              {index === 5 && (
                <ol class="space-y-1">
                  {results.map((r, i) => (
                    <li class="flex justify-between gap-3"><span class="font-medium text-ink">{i + 1}. {r.title}</span><span class="font-mono text-xs text-muted">{r.match_tier} · score {r.score}</span></li>
                  ))}
                </ol>
              )}
              {index === 6 && (
                <p>
                  The reply is worded from the decided outcome: {results.length} strong matches in {search.city}. Listing cards and the Decision
                  Inspector come straight from the same data.
                </p>
              )}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
