---
import { Braces, Database, FileSearch, ListOrdered, Network, PanelsTopLeft, Quote, Route } from "lucide-react";
import SectionHeader from "./SectionHeader.astro";

type Tag = "LLM" | "Deterministic" | "API" | "UI";
const TAG_CLASS: Record<Tag, string> = { LLM: "tag-llm", Deterministic: "tag-det", API: "tag-api", UI: "tag-ui" };

const parts = [
  {
    icon: Route,
    tile: "tile-indigo",
    title: "Conversation Router",
    tags: ["LLM"] as Tag[],
    body: "Classifies each message as a new search, a refinement, a listing question or general chat. Ambiguous turns get a clarifying question; “the second one” is validated against what was shown.",
  },
  {
    icon: Braces,
    tile: "tile-indigo",
    title: "Intent Extraction",
    tags: ["LLM", "Deterministic"] as Tag[],
    body: "Turns the message into a typed search request or a patch to the current one. Code normalises dates, asks about budget scope and never turns a monthly rate into a nightly price.",
  },
  {
    icon: Database,
    tile: "tile-emerald",
    title: "Retrieval",
    tags: ["Deterministic"] as Tag[],
    body: "Fetches candidate listings for the city and dates. The demo uses a bundled sample dataset; an optional Apify-based retriever loads live data. No embeddings.",
  },
  {
    icon: FileSearch,
    tile: "tile-emerald",
    title: "Structured Matching",
    tags: ["Deterministic"] as Tag[],
    body: "Checks requirements against canonical listing fields. Price, bedrooms, bathrooms and area are compared as numbers; area must belong to the bookable unit.",
  },
  {
    icon: Quote,
    tile: "tile-amber",
    title: "Textual Evidence Fallback",
    tags: ["LLM", "Deterministic"] as Tag[],
    body: "Requirements no field answers are read from the listing text. The model must quote the listing, quotes are verified, and code decides the verdict.",
  },
  {
    icon: ListOrdered,
    tile: "tile-emerald",
    title: "Ranking & Selection",
    tags: ["Deterministic"] as Tag[],
    body: "Sorts eligible listings into strong, partial and weak matches. An unconfirmed required item never yields a strong match; unchecked optional wishes stay visible.",
  },
  {
    icon: PanelsTopLeft,
    tile: "tile-blue",
    title: "Decision Inspector",
    tags: ["UI"] as Tag[],
    body: "A public record of each turn: routing, the understood request, every verdict with its reason and evidence, plus latency, LLM calls and estimated cost.",
  },
  {
    icon: Network,
    tile: "tile-blue",
    title: "FastAPI + Astro Demo",
    tags: ["API", "UI"] as Tag[],
    body: "One application service per turn behind POST /api/chat with per-session state. Astro and React render the public turn contract without duplicating search logic.",
  },
];

const quality = ["Typed contracts between stages", "Graceful provider failures", "Golden-set & end-to-end evaluation", "1,000+ hermetic tests"];
---

<section id="built" class="section">
  <div class="container-page">
    <SectionHeader
      title="What’s built"
      subtitle="Eight implemented parts. Language models handle language; everything that decides an outcome is ordinary, tested code."
    />
    <div class="grid gap-4 sm:grid-cols-2">
      {parts.map((part) => (
        <article class="card card-hover flex gap-4 p-5">
          <div class:list={["icon-tile", part.tile]}>
            <part.icon size={20} strokeWidth={1.5} aria-hidden="true" />
          </div>
          <div class="min-w-0">
            <div class="mb-1 flex flex-wrap items-center gap-x-2 gap-y-1">
              <h3 class="text-sm font-semibold text-ink">{part.title}</h3>
              {part.tags.map((tag) => <span class:list={["tag", TAG_CLASS[tag]]}>{tag}</span>)}
            </div>
            <p class="text-sm leading-relaxed text-muted">{part.body}</p>
          </div>
        </article>
      ))}
    </div>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-2 text-sm">
      {quality.map((item) => <span class="rounded-lg border border-line bg-white px-3 py-1.5 font-medium text-ink-soft">{item}</span>)}
    </div>
  </div>
</section>
