---
import { ArrowRight } from "lucide-react";
import { REPO_URL } from "../../lib/site";

const stack = ["Python", "Pydantic v2", "FastAPI", "Google ADK", "Gemini 2.5 Flash-Lite", "Astro", "React", "Tailwind CSS", "pytest"];
---

<section id="about" class="section">
  <div class="mx-auto max-w-3xl px-6">
    <h2 class="mb-8 text-center text-2xl font-bold tracking-tight text-ink">Built by</h2>
    <div class="card p-6">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
        <div class="grid h-14 w-14 shrink-0 place-items-center rounded-full bg-gray-100 text-lg font-bold text-ink-soft" aria-hidden="true">LM</div>
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <h3 class="text-lg font-bold text-ink">Leyla Mehtiyeva</h3>
            <span class="rounded-md bg-accent-soft px-2 py-0.5 text-xs font-medium text-accent">AI engineering project</span>
          </div>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            Booking AI was designed and built independently, end to end: conversation state, typed contracts between stages, evidence
            verification, evaluation, the API and this site.
          </p>
          <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Tech stack">
            {stack.map((item) => <li class="rounded-md border border-line bg-paper-sunk px-2 py-0.5 text-xs text-ink-soft">{item}</li>)}
          </ul>
        </div>
      </div>
      <div class="mt-6 flex flex-col gap-3 border-t border-line pt-5 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm text-muted">Code, tests and evaluation are on GitHub.</p>
        <a href={REPO_URL} class="btn btn-ghost" rel="noopener">
          View source code
          <ArrowRight size={14} strokeWidth={1.75} aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</section>
