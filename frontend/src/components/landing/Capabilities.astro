---
import { CircleHelp, Feather, MessageSquareText, MessagesSquare, ShieldQuestion, SlidersHorizontal } from "lucide-react";
import SectionHeader from "./SectionHeader.astro";

// What a user can do in a conversation. Every card is backed by the current
// backend and demo; examples are phrased the way a user would type them.
const capabilities = [
  {
    icon: MessageSquareText,
    tile: "tile-blue",
    title: "Search in natural language",
    body: "Describe the kind of accommodation you want, without filling out a page of filters.",
    example: "Find an apartment in Baku with WiFi and a balcony.",
  },
  {
    icon: SlidersHorizontal,
    tile: "tile-amber",
    title: "Refine your search",
    body: "Change your preferences mid-conversation. Everything you said before stays in the search.",
    example: "Actually, I also need a kitchen.",
  },
  {
    icon: CircleHelp,
    tile: "tile-indigo",
    title: "Ask about a listing",
    body: "Ask a follow-up about a recommended property. The answer comes from that listing’s data, or says it couldn’t be verified.",
    example: "Does the first apartment allow pets?",
  },
  {
    icon: MessagesSquare,
    tile: "tile-emerald",
    title: "Understand the recommendations",
    body: "Each result shows which of your requirements are confirmed, not confirmed or not satisfied, and why it was recommended.",
    statuses: true,
  },
  {
    icon: ShieldQuestion,
    tile: "tile-blue",
    title: "Clarify preferences",
    body: "When a request is ambiguous, Booking AI asks one follow-up question instead of guessing.",
    example: "Do you mean $200 per night or for the whole stay?",
  },
  {
    icon: Feather,
    tile: "tile-amber",
    title: "Keep some wishes optional",
    body: "Say what would only be nice to have. Optional wishes are kept apart from requirements and marked as not confirmed when the listing data is silent.",
    example: "A quiet street would be nice.",
  },
];

const STATUSES = [
  { label: "Confirmed", className: "bg-ok-soft text-ok" },
  { label: "Not confirmed", className: "bg-warn-soft text-warn" },
  { label: "Not satisfied", className: "bg-bad-soft text-bad" },
];
---

<section id="capabilities" class="section">
  <div class="container-page">
    <SectionHeader title="What Booking AI can do" subtitle="Everything happens in one conversation: search, refine, ask, and see the reasoning behind each result." />
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {capabilities.map((item) => (
        <article class="card card-hover flex flex-col p-6">
          <div class:list={["icon-tile mb-4", item.tile]}>
            <item.icon size={20} strokeWidth={1.5} aria-hidden="true" />
          </div>
          <h3 class="text-base font-semibold text-ink">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{item.body}</p>
          <div class="mt-auto pt-4">
            {item.example && (
              <p class="rounded-lg border border-line bg-paper-sunk px-3 py-2 text-[0.82rem] leading-relaxed text-ink-soft">“{item.example}”</p>
            )}
            {item.statuses && (
              <div class="flex flex-wrap gap-1.5">
                {STATUSES.map((s) => <span class:list={["rounded-md px-2 py-1 text-xs font-medium", s.className]}>{s.label}</span>)}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
