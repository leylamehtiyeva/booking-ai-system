---
import Base from "../layouts/Base.astro";
import DemoRoot from "../components/demo/DemoRoot";
---

<Base
  title="Live demo · Booking AI"
  description="Try Booking AI: describe a stay in plain language, refine the search, and inspect why each listing was recommended."
  active="demo"
>
  <div class="container-wide pb-10 pt-10 md:pt-12">
    <div class="mb-8 max-w-2xl">
      <p class="eyebrow">Live demo</p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-ink md:text-4xl">Search by describing, not filtering.</h1>
      <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">
        Every answer comes from the real backend. Listings are checked one requirement at a time, and anything the listing data does not
        confirm is shown as not confirmed — never assumed.
      </p>
    </div>
    <DemoRoot client:load />
    <noscript><p class="mt-6 text-sm text-muted">The demo needs JavaScript.</p></noscript>
  </div>
</Base>
