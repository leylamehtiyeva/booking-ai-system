---
import "../styles/global.css";
import { REPO_URL } from "../lib/site";

interface Props {
  title: string;
  description: string;
  active?: "home" | "demo";
}

const { title, description, active = "home" } = Astro.props;
// The demo uses a wider grid (chat + inspector); header and footer follow it.
const container = active === "demo" ? "container-wide" : "container-page";
const nav = [
  { href: "/#capabilities", label: "Features" },
  { href: "/#how-it-works", label: "How it works" },
  { href: "/#getting-started", label: "Get started" },
  { href: "/#faq", label: "FAQ" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-ink focus:px-3 focus:py-2 focus:text-white">
      Skip to content
    </a>
    <header class="sticky top-0 z-40 border-b border-line bg-white/90 backdrop-blur-md">
      <div class:list={[container, "flex h-14 items-center justify-between gap-4"]}>
        <a href="/" class="flex items-center gap-2" aria-label="Booking AI home">
          <span class="grid h-6 w-6 place-items-center rounded-md bg-ink text-white">
            <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path d="M4 11.5 12 5l8 6.5V19a1 1 0 0 1-1 1h-4.5v-5h-5v5H5a1 1 0 0 1-1-1z" stroke-linejoin="round"></path>
            </svg>
          </span>
          <span class="text-[15px] font-bold tracking-tight">Booking AI</span>
        </a>
        <nav class="flex items-center gap-5" aria-label="Main">
          {nav.map((item) => <a href={item.href} class="hidden text-sm text-muted transition-colors hover:text-ink md:inline">{item.label}</a>)}
          <a href={REPO_URL} class="hidden items-center gap-1.5 text-sm text-muted transition-colors hover:text-ink sm:flex" rel="noopener">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
            Source
          </a>
          <a href="/demo" class:list={["btn !px-3.5 !py-1.5", active === "demo" ? "btn-ghost" : "btn-primary"]} aria-current={active === "demo" ? "page" : undefined}>
            {active === "demo" ? "Live demo" : "Try live demo"}
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div class:list={[container, "flex flex-col gap-3 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"]}>
        <p>
          <span class="font-semibold text-ink">Booking AI</span>
          <span class="mx-2 text-subtle" aria-hidden="true">·</span>
          An AI engineering project by Leyla Mehtiyeva
        </p>
        <div class="flex gap-5">
          <a href="/demo" class="hover:text-ink">Live demo</a>
          <a href={REPO_URL} class="hover:text-ink" rel="noopener">View source code</a>
        </div>
      </div>
    </footer>
  </body>
</html>
