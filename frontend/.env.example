# Where the browser sends /api requests. Empty = same origin (the dev server
# proxies /api to BOOKING_API_PROXY_TARGET, default http://127.0.0.1:8000).
PUBLIC_API_BASE_URL=
# Development only: answer from recorded responses (src/mocks/turns.json)
# instead of the backend. Never enabled in a production build.
PUBLIC_DEMO_MOCK=
